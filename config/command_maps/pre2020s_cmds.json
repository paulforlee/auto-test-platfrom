{
  "device": "PRE2020S",
  "description": "PRE2020S AC源命令映射（SCPI）",
  "protocol": "SCPI",
  "terminator": "\n",
  "_note": "TODO: 以下命令为示例占位，需按 PRE2020S 编程手册逐条核对",
  "commands": {
    "identify": "*IDN?",
    "reset": "*RST",
    "set_voltage": "VOLT {value}",
    "set_frequency": "FREQ {value}",
    "set_current_limit": "CURR:LIM {value}",
    "output_on": "OUTP ON",
    "output_off": "OUTP OFF",
    "measure_voltage": "MEAS:VOLT?",
    "measure_current": "MEAS:CURR?",
    "measure_power": "MEAS:POW?",
    "measure_frequency": "MEAS:FREQ?"
  },
  "value_formats": {
    "voltage": "{:.3f}",
    "frequency": "{:.2f}",
    "current": "{:.3f}"
  },
  "response_parsers": {
    "measure_voltage": {"type": "float", "unit": "V"},
    "measure_current": {"type": "float", "unit": "A"},
    "measure_power": {"type": "float", "unit": "W"},
    "measure_frequency": {"type": "float", "unit": "Hz"}
  }
}
