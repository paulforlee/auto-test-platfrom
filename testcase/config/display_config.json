{
  "description": "平台展示配置（UI用）",
  "version": "0.1.0",
  "charts": [
    {
      "id": "iv_curve",
      "title": "IV 特性曲线",
      "type": "line",
      "x_axis": {"field": "voltage", "label": "电压 (V)"},
      "y_axis": {"field": "current", "label": "电流 (A)"},
      "source": "test_pv_iv_curve"
    },
    {
      "id": "pv_curve",
      "title": "P-V 功率曲线",
      "type": "line",
      "x_axis": {"field": "voltage", "label": "电压 (V)"},
      "y_axis": {"field": "power", "label": "功率 (W)"},
      "source": "test_pv_iv_curve"
    },
    {
      "id": "efficiency_curve",
      "title": "逆变器效率曲线",
      "type": "line",
      "x_axis": {"field": "load_percent", "label": "负载 (%)"},
      "y_axis": {"field": "efficiency", "label": "效率 (%)"},
      "source": "test_inverter_efficiency"
    },
    {
      "id": "mppt_tracking",
      "title": "MPPT 跟踪曲线",
      "type": "line",
      "x_axis": {"field": "time", "label": "时间 (s)"},
      "y_axis": {"field": "power", "label": "功率 (W)"},
      "source": "test_pv_mppt"
    }
  ],
  "tables": [
    {
      "id": "soft_start_steps",
      "title": "缓启动逐级数据",
      "columns": ["step", "set_voltage", "meas_voltage", "meas_current"],
      "source": "test_ac_soft_start"
    },
    {
      "id": "protection_results",
      "title": "保护测试结果",
      "columns": ["name", "triggered", "reaction_time", "faults"],
      "source": "test_inverter_protection"
    }
  ]
}
